# Ignorar archivos de sistema y temporales
.DS_Store
Thumbs.db

# IGNORAR DATOS PRIVADOS DEL CLIENTE (Crítico)
# No queremos que los CSV con precios o datos internos acaben en GitHub
/uploads/xabia/*
!/uploads/xabia/.gitkeep

# Ignorar logs de errores de PHP
error_log
php_error.log

# Ignorar configuración de IDEs locales
.vscode/
.idea/

# Credenciales y entorno local
.env
.env.local
google-key.json
**/google-key.json

# Dependencias y artefactos de build
node_modules/
vendor/
build/
xabia-agent-plugins/dist/

# Backups locales no versionados
central-api_BACKUP-*/

# Hub real: versionar código; excluir secretos y vendor
hub-real/**/.env
hub-real/**/.env.*
hub-real/**/google-key.json
hub-real/**/vendor/
hub-real/dist/

# Nota: el código fuente del Core vive en xabia-agent-plugins/packages/xabia-agent-core/
# La API del chat (class-xabia-api.php) en xabia-agent-plugins/api/ (se empaqueta en el ZIP Core).
# Addons comerciales: xabia-agent-plugins/packages/xabia-woo|mec|avirato/
# Hub: hub-real/central-api/ (espejo prod) + xabia-agent-plugins/central-api/src/ (deploy)
# Smart QR: integrado en Core (no hay paquete/ZIP xabia-smart-qr)
