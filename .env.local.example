# Xabia Release Engine — credenciales locales (NO commitear).
# Copia este archivo a .env.local en la raíz del repo y rellena los valores.
#
#   cp .env.local.example .env.local
#   chmod 600 .env.local

# --- SSH / Hostinger ---
# Usuario@host o alias de ~/.ssh/config (ej. hostinger-xabia)
XABIA_PROD_SERVER=u610697097@123.456.789.012

# Clave privada SSH (opcional si usas ssh-agent o config)
# XABIA_SSH_IDENTITY_FILE=/Users/tu/.ssh/id_ed25519_hostinger

# Puerto SSH Hostinger (opcional si ~/.ssh/config ya define Host + Port)
# XABIA_SSH_PORT=65002

# Ruta absoluta en el servidor → public_html/downloads/
XABIA_PROD_DOWNLOADS_PATH=/home/u610697097/domains/xabia.ai/public_html/downloads

# Ruta absoluta al búnker central-api (donde está el .env del Hub)
XABIA_PROD_HUB_PATH=/home/u610697097/central-api

# Ruta absoluta → public_html/docs/ (manuales PDF/HTML/MD en vivo)
XABIA_PROD_DOCS_PATH=/home/u610697097/domains/xabia.ai/public_html/docs

# Carpeta local de manuales (opcional; default: xabia-agent-plugins/documentation)
# XABIA_DOCS_LOCAL=/Users/tu/ruta/xabia-agent-next/xabia-agent-plugins/documentation

# --- URLs públicas (opcional; defaults sensatos) ---
XABIA_PUBLIC_SITE=https://xabia.ai
XABIA_PACKAGE_BASE_URL=https://xabia.ai/downloads
XABIA_DOCS_PUBLIC_BASE=https://xabia.ai/docs
# XABIA_UPDATES_URL=https://xabia.ai/api/xabia/v1/updates

# --- Git (Fase 3: commit + tag + push tras deploy verificado) ---
XABIA_GIT_BRANCH=main

# --- Cloudflare (purge selectivo tras despliegue) ---
# Token: permiso Zone → Cache Purge → Purge
XABIA_CF_ZONE_ID=
XABIA_CF_TOKEN=

# --- Polar (subida automática del ZIP retail al beneficio Downloadables) ---
# Crear token: https://polar.sh/settings → Developers → New Token
# Scopes mínimos: files:read, files:write, benefits:read, benefits:write, organizations:read
# Luego: ./scripts/polar-upload-retail.py --list
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_CORE_BENEFIT_ID=
