# Copiar a .env en la raíz central-api (junto a bootstrap.php), no hace falta dentro de public/

# Si el hub se publica como https://xabia.ai/api/xabia/v1/... y el Router no recorta bien el prefijo:
# XABIA_PUBLIC_BASE=/api

# PDO MySQL (obligatorio)
XABIA_DB_DSN=mysql:host=127.0.0.1;dbname=xabia_hub;charset=utf8mb4
XABIA_DB_USER=xabia
XABIA_DB_PASS=

# Proxy: motor exclusivo Vertex AI (obligatorio para /v1/proxy)
GOOGLE_APPLICATION_CREDENTIALS=/abs/path/service-account.json
# Producción (ej. Hostinger): ruta absoluta al JSON de la cuenta de servicio
# GOOGLE_APPLICATION_CREDENTIALS=/home/u610697097/central-api/config/google-key.json
# O una sola línea JSON (escapar comillas según tu despliegue):
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Proyecto Vertex (opcional: si vacío, se usa project_id del JSON de la cuenta de servicio)
XABIA_VERTEX_PROJECT_ID=api-traduccion-aktiba
XABIA_VERTEX_LOCATION=europe-west1
# Embeddings (text-embedding-004): por defecto misma región que XABIA_VERTEX_LOCATION (RGPD / datos en UE).
# Solo si necesitas forzar otra región UE para embeddings:
# XABIA_VERTEX_EMBEDDING_LOCATION=europe-west1
# Segunda región solo para embeddings (opcional; p. ej. otra UE). Por defecto no hay reintento fuera de la región principal.
# XABIA_VERTEX_EMBEDDING_LOCATION_FALLBACK=europe-west4
# Chat: región extra si la primera falla (por defecto us-central1). Pon "none" para no salir de la UE.
# XABIA_VERTEX_LOCATION_FALLBACK=none
# Modelos Vertex: por defecto Flash en ambos (más económico que Pro). Sube MODEL_PRO a gemini-2.5-pro solo si quieres más calidad.
XABIA_VERTEX_MODEL_FLASH=gemini-2.5-flash
XABIA_VERTEX_MODEL_PRO=gemini-2.5-flash

# Webhook Polar del servidor central. La firma hub <-> clientes usa la license_key de cada cliente.
POLAR_WEBHOOK_SECRET=whsec_tu_secreto_de_polar

# DTP (traducción automática de saludos WPML vía Hub)
# XABIA_DTP_ALLOW_ALL=1
# XABIA_DTP_ADDON_SLUG=xabia-dtp
# XABIA_DTP_VERTEX_TIER=flash

# Embeddings del worker de conocimiento (bin/cron-vectorizer.php)
# XABIA_EMBEDDING_MODEL=text-embedding-004

# Actualizaciones automáticas del plugin Core (GET /xabia/v1/updates?plugin=xabia-agent-core)
XABIA_CORE_LATEST_VERSION=1.0.203
XABIA_CORE_UPDATE_PACKAGE=https://xabia.ai/downloads/xabia-agent-core-1.0.203.zip
XABIA_CORE_UPDATE_HOMEPAGE=https://xabia.ai/docs/
XABIA_CORE_REQUIRES_WP=6.0
XABIA_CORE_TESTED_WP=6.7
XABIA_CORE_REQUIRES_PHP=7.4
XABIA_CORE_UPDATE_DATE=2026-08-11

# Addons (GET /xabia/v1/updates?plugin=xabia-woo|xabia-mec|xabia-avirato)
XABIA_WOO_LATEST_VERSION=1.0.3
XABIA_WOO_UPDATE_PACKAGE=https://xabia.ai/downloads/xabia-woo-1.0.3.zip
XABIA_MEC_LATEST_VERSION=1.0.2
XABIA_MEC_UPDATE_PACKAGE=https://xabia.ai/downloads/xabia-mec-1.0.2.zip
XABIA_AVIRATO_LATEST_VERSION=1.0.18
XABIA_AVIRATO_UPDATE_PACKAGE=https://xabia.ai/downloads/xabia-avirato-1.0.18.zip

# OPENAI_API_KEY ya no se usa en el proxy (solo Vertex). Puedes omitirla.
# OPENAI_API_KEY=
