# Xabia Central API (Hub) — plantilla .env
# Copia a .env en el servidor y rellena. NUNCA commits .env ni google-key.json.
# Código versionado: hub-real/central-api/ (espejo de producción sin secretos).

DB_STANDALONE_CONNECTION=mysql
DB_STANDALONE_DATABASE=xabia_hub
DB_STANDALONE_HOST=127.0.0.1
DB_STANDALONE_PASSWORD=CHANGE_ME
DB_STANDALONE_PORT=3306
DB_STANDALONE_USERNAME=xabia_hub
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/config/google-key.json
POLAR_PRODUCT_UUID_WOO=
POLAR_WEBHOOK_SECRET=CHANGE_ME
XABIA_AVIRATO_LATEST_VERSION=1.0.19
XABIA_AVIRATO_UPDATE_PACKAGE=https://xabia.ai/downloads/xabia-avirato-1.0.19.zip
XABIA_CORE_LATEST_VERSION=1.0.273
XABIA_CORE_REQUIRES_PHP=7.4
XABIA_CORE_REQUIRES_WP=6.0
XABIA_CORE_TESTED_WP=6.7
XABIA_CORE_UPDATE_HOMEPAGE=https://xabia.ai/docs/
XABIA_CORE_UPDATE_PACKAGE=https://xabia.ai/downloads/xabia-agent-core-1.0.273.zip
XABIA_DB_DSN=mysql:host=127.0.0.1;dbname=xabia_hub;charset=utf8mb4
XABIA_DB_PASS=CHANGE_ME
XABIA_DB_USER=xabia_hub
XABIA_MEC_LATEST_VERSION=1.0.3
XABIA_MEC_UPDATE_PACKAGE=https://xabia.ai/downloads/xabia-mec-1.0.3.zip
XABIA_PUBLIC_BASE=https://xabia.ai
XABIA_VERTEX_LOCATION=europe-southwest1
XABIA_VERTEX_LOCATION_FALLBACK=us-central1
XABIA_VERTEX_MODEL_FLASH=gemini-2.5-flash
XABIA_VERTEX_MODEL_PRO=gemini-2.5-flash
XABIA_VERTEX_PROJECT_ID=your-gcp-project-id
XABIA_WOO_LATEST_VERSION=1.0.4
XABIA_WOO_UPDATE_PACKAGE=https://xabia.ai/downloads/xabia-woo-1.0.4.zip
